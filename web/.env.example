# Environment for the SpaceKit website (set these in Coolify → your app → Environment Variables).

# Stripe restricted key with one permission: Checkout Sessions → Read.
# Dashboard → Developers → API keys → Create restricted key. Use rk_test_… while testing.
STRIPE_SECRET_KEY=rk_live_...

# The $5 Payment Link (Dashboard → Payment Links). Its URL, and its id (plink_…), so a payment
# from any other link on the account can't unlock the download.
STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/...
STRIPE_PAYMENT_LINK_ID=plink_...

# Signs the short-lived download links. Any random string of 32+ characters:
#   openssl rand -hex 32
DOWNLOAD_SECRET=

# Seller details for the footer, Terms, Privacy and Refund pages (Stripe and EU law require them).
BUSINESS_NAME=AppRise Ventures Oy
BUSINESS_ID=1234567-8
BUSINESS_ADDRESS=Street 1, 00100 Helsinki, Finland
SUPPORT_EMAIL=support@example.com

# Where the installer lives inside the container (a persistent volume). The newest .pkg there is
# served; set INSTALLER_FILE to pin one by name.
DOWNLOADS_DIR=/data/downloads
# INSTALLER_FILE=SpaceKit-0.1.0.pkg

# How long a download link works, in seconds. The download page issues a fresh one on every visit.
# DOWNLOAD_TTL_SECONDS=3600

# PORT=3000
